# Copy this file to ~/.claude_usage.env and customise as needed.

# Anthropic API key — used by the "Fetch limits" feature (press L).
# Not required if you use Claude Code (credentials are picked up automatically).
ANTHROPIC_API_KEY=sk-ant-...

# Dashboard auto-refresh interval in seconds (default: 30).
# CLAUDE_USAGE_REFRESH_INTERVAL=30
