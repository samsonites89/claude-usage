/* ── Layout ────────────────────────────────────────────────────── */

Screen {
    layout: vertical;
    align: center top;
}

ClawdBanner {
    height: 5;
    width: 100%;
    max-width: 220;
    text-align: center;
    border: solid $accent;
    padding: 1 0;
}

#main {
    layout: horizontal;
    height: 1fr;
    max-width: 220;
}

#right {
    layout: vertical;
    width: 1fr;
    height: 100%;
}

#charts {
    layout: horizontal;
    height: 1fr;
}

/* ── SummaryPanel ──────────────────────────────────────────────── */

SummaryPanel {
    width: 38;
    height: 100%;
    border: solid $primary;
    padding: 1 2;
}

/* ── DailyChart ────────────────────────────────────────────────── */

DailyChart {
    height: 1fr;
    border: solid $primary;
    padding: 1 2;
    overflow-y: auto;
}

/* ── WeeklyChart ───────────────────────────────────────────────── */

WeeklyChart {
    height: 1fr;
    border: solid $primary;
    padding: 1 2;
    overflow-y: auto;
}

/* ── SessionsTable ─────────────────────────────────────────────── */

SessionsTable {
    height: 1fr;
    border: solid $primary;
    padding: 1 2;
    overflow-y: auto;
}

/* ── RefreshPopup ──────────────────────────────────────────────── */

RefreshPopup {
    align: center middle;
    background: $background 0%;
}

RefreshPopup > Static {
    width: auto;
    height: auto;
    padding: 2 6;
    border: round $primary;
    background: $surface;
    text-align: center;
}
